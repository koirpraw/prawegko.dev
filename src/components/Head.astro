---
// Bundled stylesheet — importing here lets Astro hash + emit it into dist/_astro/.
// A raw <link href="/src/..."> is served verbatim in dev but never built for production.
import '../styles/global.css';
import JsonLd from './JsonLd.astro';
import {
  absoluteUrl,
  ogImage,
  personNode,
  websiteNode,
  FEED_PATH,
  FEED_TITLE,
  FEED_TYPE,
  OG_IMAGE_HEIGHT,
  OG_IMAGE_WIDTH,
  type JsonLdBlock,
} from '../lib/structured-data';

interface Props {
  title: string;
  description: string;
  ogType?: string;
  /** Extra @id-linked nodes for this page (BlogPosting, BreadcrumbList, …). */
  structuredData?: JsonLdBlock[];
  /** Card slug under /og/ — falls back to the site card when that file is not in the build. */
  ogSlug?: string;
  /**
   * Emit `noindex` instead of a canonical (404 and any other page that must not be
   * indexed). Same pattern pkolabs.com uses.
   */
  noCanonical?: boolean;
}

const {
  title,
  description,
  ogType,
  structuredData = [],
  ogSlug,
  noCanonical = false,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const card = ogImage(ogSlug, title);
---

<script is:inline>
  // Apply saved theme before first paint to avoid a flash of the wrong theme.
  (() => {
    try {
      const t = localStorage.getItem('theme');
      if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
    } catch {}
  })();
</script>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<!-- Google tag (gtag.js) — GA4 property 559701532. Direct gtag.js, deliberately NOT a GTM
     container (Praweg's decision 2026-10-19). `is:inline` keeps both snippets verbatim
     in the served head: Astro would otherwise hoist/bundle them. -->
<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-D8R5CVHEJC"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-D8R5CVHEJC');
</script>

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="apple-touch-icon" href="/favicon.svg" />
{noCanonical ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalUrl} />}
<link rel="alternate" type={FEED_TYPE} title={FEED_TITLE} href={absoluteUrl(FEED_PATH)} />
<title>{title}</title>
<meta name="description" content={description} />

<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content={ogType || 'website'} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:site_name" content="Praweg Koirala" />
<meta property="og:image" content={card.url} />
<meta property="og:image:width" content={String(OG_IMAGE_WIDTH)} />
<meta property="og:image:height" content={String(OG_IMAGE_HEIGHT)} />
<meta property="og:image:alt" content={card.alt} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={card.url} />
<meta name="twitter:image:alt" content={card.alt} />

<JsonLd id="ld-person" data={personNode()} />
<JsonLd id="ld-website" data={websiteNode()} />
{structuredData.map((block) => <JsonLd id={block.id} data={block.data} />)}
