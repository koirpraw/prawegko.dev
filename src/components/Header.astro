---
const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/projects', label: 'Projects' },
  { href: '/blog', label: 'Blog' },
  { href: '/now', label: 'Now' },
  { href: '/resume', label: 'Resume' },
  { href: '/contact', label: 'Contact' },
];
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="sticky top-0 z-100 border-b border-line bg-surface/90 backdrop-blur-md">
  <nav class="mx-auto flex w-full max-w-6xl items-center justify-between gap-4 px-8 py-4 max-sm:flex-col">
    <a href="/" class="text-lg font-bold tracking-tight text-fg hover:text-accent">prawegko.dev</a>
    <div class="flex flex-wrap items-center gap-4">
      {navLinks.map(({ href, label }) => (
        <a
          href={href}
          aria-current={currentPath === href ? 'page' : undefined}
          class:list={[
            'text-sm text-muted no-underline transition-colors hover:text-accent',
            currentPath === href && 'font-semibold text-accent',
          ]}
        >
          {label}
        </a>
      ))}
      <button
        id="theme-toggle"
        type="button"
        aria-label="Toggle color theme"
        class="cursor-pointer rounded-sm border border-line px-2 py-0.5 text-lg leading-none text-muted transition-colors hover:border-accent hover:text-accent"
      >&#x263E;</button>
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById('theme-toggle');
  const SUN = '\u2600';
  const MOON = '\u263E';
  const sync = () => {
    if (!btn) return;
    // Show the icon for the theme you'd switch TO.
    btn.innerHTML = document.documentElement.dataset.theme === 'light' ? MOON : SUN;
  };
  btn?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
    sync();
  });
  sync();
</script>
