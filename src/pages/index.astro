---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Head from '../components/Head.astro';
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <Head title="Praweg Koirala — Software Engineer & Entrepreneur" description="Entrepreneur who codes — building AI-powered products on the cloud. Explore projects, blog, and more." ogType="website" />
  </head>
  <body>
    <Header />

    <main>
      <section class="hero content-container">
        <div class="hero-content">
          <p class="hero-greeting">Hi, I'm</p>
          <h1 class="hero-name">Praweg Koirala</h1>
          <p class="hero-tagline">Entrepreneur who codes — building AI-powered products on the cloud</p>
          <p class="hero-rotator">
            <span class="typewriter" data-words='["Software Engineer", "Entrepreneur", "Tinkerer", "New Dad"]'></span>
            <span class="typewriter-cursor"></span>
          </p>
          <div class="hero-actions">
            <a href="/projects" class="btn btn-primary">View Projects</a>
            <a href="/about" class="btn btn-outline">About Me</a>
          </div>
        </div>
      </section>

      <section class="stats-section content-container">
        <div class="stats-grid">
          <div class="stat-card">
            <span class="stat-num">10+</span>
            <span class="stat-desc">Years Building</span>
          </div>
          <div class="stat-card">
            <span class="stat-num">5+</span>
            <span class="stat-desc">Projects Shipped</span>
          </div>
          <div class="stat-card">
            <span class="stat-num">3</span>
            <span class="stat-desc">Cloud Certs</span>
          </div>
          <div class="stat-card">
            <span class="stat-num">2</span>
            <span class="stat-desc">AI Agents Certs</span>
          </div>
        </div>
      </section>

      <section class="featured-section content-container">
        <h2 class="section-title">Featured Projects</h2>
        <div class="featured-grid">
          <article class="preview-card">
            <div class="preview-card-body">
              <h3><a href="/projects/kids-story-generator">Kids Story Generator</a></h3>
              <p>Agentic AI pipeline using Python/ADK/Gemini that generates illustrated children's stories.</p>
              <div class="tags-row">
                <span class="tag">Python</span>
                <span class="tag">ADK</span>
                <span class="tag">Gemini</span>
                <span class="tag">AI Agents</span>
              </div>
            </div>
          </article>
          <article class="preview-card">
            <div class="preview-card-body">
              <h3><a href="/projects/comfyui-gcp-storage">ComfyUI GCP Storage Decouple</a></h3>
              <p>Custom ComfyUI node that decouples storage from compute — read/write cloud storage directly.</p>
              <div class="tags-row">
                <span class="tag">Python</span>
                <span class="tag">ComfyUI</span>
                <span class="tag">GCP</span>
                <span class="tag">Cloud Storage</span>
              </div>
            </div>
          </article>
        </div>
        <div class="section-action">
          <a href="/projects" class="btn btn-outline">All Projects &rarr;</a>
        </div>
      </section>

      <section class="latest-blog content-container">
        <h2 class="section-title">Latest Blog</h2>
        <div class="blog-preview-list">
          <article class="preview-card">
            <div class="preview-card-body">
              <time datetime="2026-09-30">September 30, 2026</time>
              <h3><a href="/blog/hello-world">Hello, World — New Site, New Stack</a></h3>
              <p>Rebuilding prawegko.dev with Astro, deployed on S3/CloudFront with OIDC CI/CD.</p>
              <div class="tags-row">
                <span class="tag">Meta</span>
                <span class="tag">Astro</span>
                <span class="tag">AWS</span>
              </div>
            </div>
          </article>
        </div>
        <div class="section-action">
          <a href="/blog" class="btn btn-outline">All Posts &rarr;</a>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>

<script>
(function() {
  const html = document.documentElement;
  const stored = localStorage.getItem('theme');
  if (stored === 'light' || stored === 'dark') {
    html.setAttribute('data-theme', stored);
  }
})();
</script>

<script>
const twEls = document.querySelectorAll('.typewriter');
twEls.forEach(el => {
  const words = JSON.parse(el.dataset.words || '[]');
  if (!words.length) return;
  let wordIdx = 0, charIdx = 0, deleting = false;
  setInterval(() => {
    const current = words[wordIdx];
    if (!deleting) {
      charIdx++;
      el.textContent = current.slice(0, charIdx);
      if (charIdx >= current.length) {
        setTimeout(() => { deleting = true; }, 1500);
      }
    } else {
      charIdx--;
      el.textContent = current.slice(0, charIdx);
      if (charIdx <= 0) {
        deleting = false;
        charIdx = 0;
        wordIdx = (wordIdx + 1) % words.length;
      }
    }
  }, 80);
});
</script>

<script define:vars={{ defaultJsonLd: `{
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Praweg Koirala",
  "url": "https://prawegko.dev",
  "jobTitle": "Software Engineer & Entrepreneur",
  "sameAs": [
    "https://github.com/koirpraw",
    "https://www.linkedin.com/in/prawegko"
  ],
  "knowsAbout": ["Software Engineering", "Cloud Computing", "Artificial Intelligence", "Product Development"]
}` }}></script>