---
import BaseLayout from '../layouts/BaseLayout.astro';

// Override BaseLayout's default Person schema — this page adds knowsAbout.
const jsonLd = `{
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Praweg Koirala",
  "url": "https://prawegko.dev",
  "jobTitle": "Software Engineer & Entrepreneur",
  "sameAs": [
    "https://github.com/koirpraw",
    "https://www.linkedin.com/in/prawegko"
  ],
  "knowsAbout": ["Software Engineering", "Cloud Computing", "Artificial Intelligence", "Product Development"]
}`;
---

<BaseLayout
  title="Praweg Koirala — Software Engineer & Entrepreneur"
  description="Entrepreneur who codes — building AI-powered products on the cloud. Explore projects, blog, and more."
  ogType="website"
  jsonLd={jsonLd}
>
  <section class="py-16 text-center md:py-24">
    <p class="mb-4 text-lg text-muted">Hi, I'm</p>
    <h1 class="mb-4 text-5xl font-extrabold tracking-[-0.02em]">Praweg Koirala</h1>
    <p class="mb-6 text-lg text-muted">Entrepreneur who codes — building AI-powered products on the cloud</p>
    <p class="mb-8 text-xl font-mono text-accent">
      <span class="typewriter" data-words='["Software Engineer", "Entrepreneur", "Tinkerer", "New Dad"]'></span>
      <span class="typewriter-cursor"></span>
    </p>
    <div class="flex flex-wrap items-center justify-center gap-4">
      <a href="/projects" class="inline-flex cursor-pointer items-center gap-2 rounded-sm border border-transparent bg-accent px-8 py-2 text-base font-semibold text-white transition-colors hover:bg-accent-hover">View Projects</a>
      <a href="/about" class="inline-flex cursor-pointer items-center gap-2 rounded-sm border border-line px-8 py-2 text-base font-semibold text-fg transition-colors hover:border-accent hover:bg-card hover:text-accent">About Me</a>
    </div>
  </section>

  <section class="py-16">
    <div class="grid grid-cols-2 gap-8 md:grid-cols-4">
      <div class="rounded-md border border-line bg-card p-8 text-center transition duration-200 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-accent/10">
        <span class="block text-5xl font-bold tracking-[-0.03em]">10+</span>
        <span class="mt-1 block text-sm text-muted">Years Building</span>
      </div>
      <div class="rounded-md border border-line bg-card p-8 text-center transition duration-200 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-accent/10">
        <span class="block text-5xl font-bold tracking-[-0.03em]">5+</span>
        <span class="mt-1 block text-sm text-muted">Projects Shipped</span>
      </div>
      <div class="rounded-md border border-line bg-card p-8 text-center transition duration-200 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-accent/10">
        <span class="block text-5xl font-bold tracking-[-0.03em]">3</span>
        <span class="mt-1 block text-sm text-muted">Cloud Certs</span>
      </div>
      <div class="rounded-md border border-line bg-card p-8 text-center transition duration-200 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-accent/10">
        <span class="block text-5xl font-bold tracking-[-0.03em]">2</span>
        <span class="mt-1 block text-sm text-muted">AI Agents Certs</span>
      </div>
    </div>
  </section>

  <section class="py-16">
    <h2 class="mb-8 text-[2rem] font-bold tracking-[-0.02em]">Featured Projects</h2>
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="overflow-hidden rounded-md border border-line bg-card p-8 transition duration-200 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-accent/10">
        <h3 class="mb-2 text-xl font-semibold">
          <a href="/projects/kids-story-generator" class="text-accent transition-colors hover:text-accent-hover hover:underline">Kids Story Generator</a>
        </h3>
        <p class="mb-4 text-muted">Agentic AI pipeline using Python/ADK/Gemini that generates illustrated children's stories.</p>
        <div class="flex flex-wrap gap-2">
          <span class="inline-block rounded-full bg-accent/12 px-2.5 py-0.5 text-sm font-medium text-accent">Python</span>
          <span class="inline-block rounded-full bg-accent/12 px-2.5 py-0.5 text-sm font-medium text-accent">ADK</span>
          <span class="inline-block rounded-full bg-accent/12 px-2.5 py-0.5 text-sm font-medium text-accent">Gemini</span>
          <span class="inline-block rounded-full bg-accent/12 px-2.5 py-0.5 text-sm font-medium text-accent">AI Agents</span>
        </div>
      </article>
      <article class="overflow-hidden rounded-md border border-line bg-card p-8 transition duration-200 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-accent/10">
        <h3 class="mb-2 text-xl font-semibold">
          <a href="/projects/comfyui-gcp-storage" class="text-accent transition-colors hover:text-accent-hover hover:underline">ComfyUI GCP Storage Decouple</a>
        </h3>
        <p class="mb-4 text-muted">Custom ComfyUI node that decouples storage from compute — read/write cloud storage directly.</p>
        <div class="flex flex-wrap gap-2">
          <span class="inline-block rounded-full bg-accent/12 px-2.5 py-0.5 text-sm font-medium text-accent">Python</span>
          <span class="inline-block rounded-full bg-accent/12 px-2.5 py-0.5 text-sm font-medium text-accent">ComfyUI</span>
          <span class="inline-block rounded-full bg-accent/12 px-2.5 py-0.5 text-sm font-medium text-accent">GCP</span>
          <span class="inline-block rounded-full bg-accent/12 px-2.5 py-0.5 text-sm font-medium text-accent">Cloud Storage</span>
        </div>
      </article>
    </div>
    <div class="mt-8">
      <a href="/projects" class="inline-flex cursor-pointer items-center gap-2 rounded-sm border border-line px-8 py-2 text-base font-semibold text-fg transition-colors hover:border-accent hover:bg-card hover:text-accent">All Projects &rarr;</a>
    </div>
  </section>

  <section class="py-16">
    <h2 class="mb-8 text-[2rem] font-bold tracking-[-0.02em]">Latest Blog</h2>
    <div class="flex flex-col gap-8">
      <article class="overflow-hidden rounded-md border border-line bg-card p-8 transition duration-200 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-accent/10">
        <time class="mb-2 block text-sm text-muted" datetime="2026-09-30">September 30, 2026</time>
        <h3 class="mb-2 text-xl font-semibold">
          <a href="/blog/hello-world" class="text-accent transition-colors hover:text-accent-hover hover:underline">Hello, World — New Site, New Stack</a>
        </h3>
        <p class="mb-4 text-muted">Rebuilding prawegko.dev with Astro, deployed on S3/CloudFront with OIDC CI/CD.</p>
        <div class="flex flex-wrap gap-2">
          <span class="inline-block rounded-full bg-accent/12 px-2.5 py-0.5 text-sm font-medium text-accent">Meta</span>
          <span class="inline-block rounded-full bg-accent/12 px-2.5 py-0.5 text-sm font-medium text-accent">Astro</span>
          <span class="inline-block rounded-full bg-accent/12 px-2.5 py-0.5 text-sm font-medium text-accent">AWS</span>
        </div>
      </article>
    </div>
    <div class="mt-8">
      <a href="/blog" class="inline-flex cursor-pointer items-center gap-2 rounded-sm border border-line px-8 py-2 text-base font-semibold text-fg transition-colors hover:border-accent hover:bg-card hover:text-accent">All Posts &rarr;</a>
    </div>
  </section>
</BaseLayout>
