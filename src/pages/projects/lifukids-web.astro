---
import ProjectLayout from '../../layouts/ProjectLayout.astro';

const frontmatter = {
  title: 'LifuKids Web',
  description: 'Kids learning platform built with NextJS and TypeScript.',
  subtitle: 'Kids learning platform built with NextJS and TypeScript — interactive content, gamification, and progress tracking.',
  tags: ['NextJS', 'TypeScript', 'Web App', 'Education'],
  github: 'https://github.com/koirpraw',
};
---

<ProjectLayout frontmatter={frontmatter}>
  <h2>Overview</h2>
  <p>Interactive learning platform for children. Features gamified educational content, progress tracking for parents, and engaging UI for young learners.</p>
  <ul>
    <li>Interactive lessons with multimedia</li>
    <li>Points, badges, and level progression</li>
    <li>Parent dashboard for progress tracking</li>
    <li>Responsive design (desktop + tablet)</li>
  </ul>
  <h3>Tech Stack</h3>
  <p>NextJS (Pages Router), TypeScript, Tailwind CSS, PostgreSQL (Prisma), NextAuth.js, Vercel.</p>
</ProjectLayout>
