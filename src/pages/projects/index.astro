---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Projects — Praweg Koirala"
  description="A selection of projects by Praweg Koirala — AI pipelines, cloud tools, mobile apps, and full-stack platforms."
  ogType="website"
>
  <h1 class="mb-2 text-5xl font-extrabold tracking-[-0.02em]">Projects</h1>
  <p class="mb-8 text-lg text-muted">Selected case studies — from agentic AI to full-stack apps.</p>

  <div class="mb-8 flex flex-wrap gap-2">
    <button class="filter-btn cursor-pointer rounded-sm border border-line bg-transparent px-4 py-1 text-sm text-muted transition-colors hover:border-accent hover:bg-accent/10 hover:text-accent" data-filter="all" onclick="filterProjects('all')">All</button>
    <button class="filter-btn cursor-pointer rounded-sm border border-line bg-transparent px-4 py-1 text-sm text-muted transition-colors hover:border-accent hover:bg-accent/10 hover:text-accent" data-filter="Python" onclick="filterProjects('Python')">Python</button>
    <button class="filter-btn cursor-pointer rounded-sm border border-line bg-transparent px-4 py-1 text-sm text-muted transition-colors hover:border-accent hover:bg-accent/10 hover:text-accent" data-filter="Flutter" onclick="filterProjects('Flutter')">Flutter</button>
    <button class="filter-btn cursor-pointer rounded-sm border border-line bg-transparent px-4 py-1 text-sm text-muted transition-colors hover:border-accent hover:bg-accent/10 hover:text-accent" data-filter="TypeScript" onclick="filterProjects('TypeScript')">TypeScript</button>
    <button class="filter-btn cursor-pointer rounded-sm border border-line bg-transparent px-4 py-1 text-sm text-muted transition-colors hover:border-accent hover:bg-accent/10 hover:text-accent" data-filter="NextJS" onclick="filterProjects('NextJS')">NextJS</button>
  </div>

  <div class="grid grid-cols-[repeat(auto-fill,minmax(340px,1fr))] gap-8" id="projects-grid">
    <article class="project-card rounded-md border border-line bg-card p-8 transition duration-200 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-accent/10" data-tags="Python,AI">
      <h2 class="mb-2 text-2xl font-bold">
        <a href="/projects/kids-story-generator" class="text-fg no-underline transition-colors hover:text-accent">Kids Story Generator</a>
      </h2>
      <p class="mb-4 leading-[1.6] text-muted">Agentic AI pipeline using Python/ADK/Gemini that generates illustrated children's stories from simple prompts. Multi-agent orchestration for narrative, illustration, and formatting.</p>
      <div class="mb-2 flex flex-wrap gap-1">
        <span class="tag inline-block rounded-full bg-accent/12 px-2.5 py-0.5 text-sm font-medium text-accent">Python</span>
        <span class="tag inline-block rounded-full bg-accent/12 px-2.5 py-0.5 text-sm font-medium text-accent">ADK</span>
        <span class="tag inline-block rounded-full bg-accent/12 px-2.5 py-0.5 text-sm font-medium text-accent">Gemini</span>
        <span class="tag inline-block rounded-full bg-accent/12 px-2.5 py-0.5 text-sm font-medium text-accent">AI Agents</span>
      </div>
      <div class="mt-2">
        <a href="https://github.com/koirpraw" class="inline-flex cursor-pointer items-center gap-2 rounded-sm border border-line px-8 py-2 text-base font-semibold transition-colors hover:border-accent hover:bg-card hover:text-accent">Source</a>
      </div>
    </article>

    <article class="project-card rounded-md border border-line bg-card p-8 transition duration-200 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-accent/10" data-tags="Python,AI,Cloud">
      <h2 class="mb-2 text-2xl font-bold">
        <a href="/projects/comfyui-gcp-storage" class="text-fg no-underline transition-colors hover:text-accent">ComfyUI GCP Storage Decouple</a>
      </h2>
      <p class="mb-4 leading-[1.6] text-muted">Custom ComfyUI node that decouples storage from compute. Enables ComfyUI workflows to read inputs from and write outputs to GCP/AWS cloud storage directly.</p>
      <div class="mb-2 flex flex-wrap gap-1">
        <span class="tag inline-block rounded-full bg-accent/12 px-2.5 py-0.5 text-sm font-medium text-accent">Python</span>
        <span class="tag inline-block rounded-full bg-accent/12 px-2.5 py-0.5 text-sm font-medium text-accent">ComfyUI</span>
        <span class="tag inline-block rounded-full bg-accent/12 px-2.5 py-0.5 text-sm font-medium text-accent">GCP</span>
        <span class="tag inline-block rounded-full bg-accent/12 px-2.5 py-0.5 text-sm font-medium text-accent">Cloud Storage</span>
      </div>
      <div class="mt-2">
        <a href="https://github.com/koirpraw" class="inline-flex cursor-pointer items-center gap-2 rounded-sm border border-line px-8 py-2 text-base font-semibold transition-colors hover:border-accent hover:bg-card hover:text-accent">Source</a>
      </div>
    </article>

    <article class="project-card rounded-md border border-line bg-card p-8 transition duration-200 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-accent/10" data-tags="Flutter">
      <h2 class="mb-2 text-2xl font-bold">
        <a href="/projects/goatreport" class="text-fg no-underline transition-colors hover:text-accent">GoatReport</a>
      </h2>
      <p class="mb-4 leading-[1.6] text-muted">Fitness tracking app built with Flutter. Users can log workouts, track progress over time, set goals, and view analytics. Clean, modern mobile UX.</p>
      <div class="mb-2 flex flex-wrap gap-1">
        <span class="tag inline-block rounded-full bg-accent/12 px-2.5 py-0.5 text-sm font-medium text-accent">Flutter</span>
        <span class="tag inline-block rounded-full bg-accent/12 px-2.5 py-0.5 text-sm font-medium text-accent">Dart</span>
        <span class="tag inline-block rounded-full bg-accent/12 px-2.5 py-0.5 text-sm font-medium text-accent">Mobile</span>
      </div>
      <div class="mt-2">
        <a href="https://github.com/koirpraw" class="inline-flex cursor-pointer items-center gap-2 rounded-sm border border-line px-8 py-2 text-base font-semibold transition-colors hover:border-accent hover:bg-card hover:text-accent">Source</a>
      </div>
    </article>

    <article class="project-card rounded-md border border-line bg-card p-8 transition duration-200 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-accent/10" data-tags="NextJS,TypeScript">
      <h2 class="mb-2 text-2xl font-bold">
        <a href="/projects/lifukids-web" class="text-fg no-underline transition-colors hover:text-accent">LifuKids Web</a>
      </h2>
      <p class="mb-4 leading-[1.6] text-muted">Kids learning platform built with NextJS and TypeScript. Interactive educational content with gamification, progress tracking, and parent dashboards.</p>
      <div class="mb-2 flex flex-wrap gap-1">
        <span class="tag inline-block rounded-full bg-accent/12 px-2.5 py-0.5 text-sm font-medium text-accent">NextJS</span>
        <span class="tag inline-block rounded-full bg-accent/12 px-2.5 py-0.5 text-sm font-medium text-accent">TypeScript</span>
        <span class="tag inline-block rounded-full bg-accent/12 px-2.5 py-0.5 text-sm font-medium text-accent">Web App</span>
      </div>
      <div class="mt-2">
        <a href="https://github.com/koirpraw" class="inline-flex cursor-pointer items-center gap-2 rounded-sm border border-line px-8 py-2 text-base font-semibold transition-colors hover:border-accent hover:bg-card hover:text-accent">Source</a>
      </div>
    </article>

    <article class="project-card rounded-md border border-line bg-card p-8 transition duration-200 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-accent/10" data-tags="JavaScript,MongoDB,React">
      <h2 class="mb-2 text-2xl font-bold">
        <a href="/projects/mern-jobs-board" class="text-fg no-underline transition-colors hover:text-accent">MERN Jobs Board</a>
      </h2>
      <p class="mb-4 leading-[1.6] text-muted">Full-stack CRUD job board application built with MongoDB, Express, React, and Node.js. Features user authentication, job posting, search, and application tracking.</p>
      <div class="mb-2 flex flex-wrap gap-1">
        <span class="tag inline-block rounded-full bg-accent/12 px-2.5 py-0.5 text-sm font-medium text-accent">MongoDB</span>
        <span class="tag inline-block rounded-full bg-accent/12 px-2.5 py-0.5 text-sm font-medium text-accent">Express</span>
        <span class="tag inline-block rounded-full bg-accent/12 px-2.5 py-0.5 text-sm font-medium text-accent">React</span>
        <span class="tag inline-block rounded-full bg-accent/12 px-2.5 py-0.5 text-sm font-medium text-accent">Node.js</span>
      </div>
      <div class="mt-2">
        <a href="https://github.com/koirpraw" class="inline-flex cursor-pointer items-center gap-2 rounded-sm border border-line px-8 py-2 text-base font-semibold transition-colors hover:border-accent hover:bg-card hover:text-accent">Source</a>
      </div>
    </article>
  </div>
</BaseLayout>

<script>
function filterProjects(tag) {
  const grid = document.getElementById('projects-grid');
  const cards = grid.querySelectorAll('.project-card');
  const buttons = document.querySelectorAll('.filter-btn');
  buttons.forEach(b => b.classList.toggle('active', b.dataset.filter === tag));
  cards.forEach(card => {
    const tags = card.dataset.tags || '';
    if (tag === 'all' || tags.includes(tag)) {
      card.style.display = '';
    } else {
      card.style.display = 'none';
    }
  });
}
</script>

<style>
  /* .active is toggled by the filter script above — JS-toggled state can't be a static utility. */
  .filter-btn.active {
    border-color: var(--color-accent);
    color: var(--color-accent);
    background: rgb(79 143 255 / 0.1);
  }
  /* First tag of AI-tagged projects gets the success tint; attribute-value selectors aren't expressible as utilities. (success color was #34d399 in the pre-Tailwind palette) */
  .project-card[data-tags*="AI"] .tag:first-child {
    background: rgb(52 211 153 / 0.15);
    color: #34d399;
  }
</style>
