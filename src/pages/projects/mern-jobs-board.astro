---
import ProjectLayout from '../../layouts/ProjectLayout.astro';

const frontmatter = {
  title: 'MERN Jobs Board',
  description: 'Full-stack CRUD job board with user auth.',
  subtitle: 'Full-stack CRUD job board with user auth, job posting, search, and application tracking.',
  tags: ['MongoDB', 'Express', 'React', 'Node.js'],
  github: 'https://github.com/koirpraw',
};
---

<ProjectLayout frontmatter={frontmatter}>
  <h2>Overview</h2>
  <p>Full-stack job board built with the MERN stack. Users can post jobs, search listings, apply for positions, and track their applications.</p>
  <h3>Features</h3>
  <ul>
    <li>JWT-based authentication with profile management</li>
    <li>Job CRUD with search and filtering</li>
    <li>Application tracking system</li>
    <li>Responsive UI</li>
  </ul>
  <h3>API Endpoints</h3>
  <pre><code>GET    /api/jobs          — List jobs (search/filter)
GET    /api/jobs/:id      — Get job details
POST   /api/jobs          — Create job (auth)
POST   /api/applications  — Apply to job (auth)</code></pre>
</ProjectLayout>
