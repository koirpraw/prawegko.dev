---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="404 — Page Not Found"
  description="The page you're looking for doesn't exist."
>
  <div class="flex min-h-[60vh] flex-col items-center justify-center text-center">
    <h1 class="mb-4 text-[clamp(5rem,12vw,10rem)] font-extrabold leading-none tracking-[-0.05em] text-accent">404</h1>
    <p class="mb-4 text-[2rem]">The page you're looking for doesn't exist.</p>
    <p class="mb-16 text-muted">It might have moved, been renamed, or never existed in the first place.</p>
    <a href="/" class="inline-flex cursor-pointer items-center gap-2 rounded-sm border border-transparent bg-accent px-8 py-2 text-base font-semibold text-white transition-colors hover:bg-accent-hover">&larr; Back to Home</a>
  </div>
</BaseLayout>
