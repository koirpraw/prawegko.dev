---
import Head from '../components/Head.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import type { JsonLdBlock } from '../lib/structured-data';

interface Props {
  title: string;
  description: string;
  ogType?: string;
  /** Extra @id-linked JSON-LD nodes for this page; Person + WebSite are emitted for every page. */
  structuredData?: JsonLdBlock[];
  /** Card slug under /og/ — falls back to the site card when that file is not in the build. */
  ogSlug?: string;
  /** Emit `noindex` instead of a canonical (404 and any other non-indexable page). */
  noCanonical?: boolean;
  /** Drop the default horizontal container for pages that manage their own layout (rare). */
  contained?: boolean;
}

const {
  title,
  description,
  ogType,
  structuredData,
  ogSlug,
  noCanonical,
  contained = true,
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <Head
      title={title}
      description={description}
      ogType={ogType}
      structuredData={structuredData}
      ogSlug={ogSlug}
      noCanonical={noCanonical}
    />
  </head>
  <body class="flex min-h-screen flex-col bg-bg font-sans text-fg antialiased">
    <Header />
    <main class:list={['w-full flex-1 py-12', contained && 'mx-auto max-w-6xl px-8']}>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<script>
  // Typewriter effect — runs on every page that includes a .typewriter element.
  const twEls = document.querySelectorAll<HTMLElement>('.typewriter');
  twEls.forEach((el) => {
    const words: string[] = JSON.parse(el.dataset.words || '[]');
    if (!words.length) return;
    let wordIdx = 0, charIdx = 0, deleting = false;
    setInterval(() => {
      const current = words[wordIdx];
      if (!deleting) {
        charIdx++;
        el.textContent = current.slice(0, charIdx);
        if (charIdx >= current.length) {
          setTimeout(() => { deleting = true; }, 1500);
        }
      } else {
        charIdx--;
        el.textContent = current.slice(0, charIdx);
        if (charIdx <= 0) {
          deleting = false;
          charIdx = 0;
          wordIdx = (wordIdx + 1) % words.length;
        }
      }
    }, 80);
  });
</script>
