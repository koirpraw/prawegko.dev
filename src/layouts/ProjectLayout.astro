---
import BaseLayout from './BaseLayout.astro';

interface Props {
  frontmatter: {
    title: string;
    description?: string;
    /** On-page subtitle; falls back to description. */
    subtitle?: string;
    tags?: string[];
    date?: Date;
    github?: string;
    live_url?: string;
  };
}

const { frontmatter } = Astro.props;
---

<BaseLayout
  title={frontmatter.title || 'Project'}
  description={frontmatter.description || ''}
  ogType="article"
>
  <article class="prose">
    <header class="mb-8">
      <h1 class="mb-0 text-4xl font-extrabold tracking-tight">{frontmatter.title}</h1>
      <p class="mt-2 text-lg text-muted">{frontmatter.subtitle || frontmatter.description}</p>
      <div class="mt-2 flex flex-wrap gap-1">
        {Array.from(frontmatter.tags || []).map((tag) => (
          <span class="inline-block rounded-full bg-accent/12 px-2.5 py-0.5 text-sm font-medium text-accent">{tag}</span>
        ))}
      </div>
      <div class="mt-8 flex gap-4">
        {frontmatter.github && (
          <a href={frontmatter.github} class="inline-flex items-center gap-2 rounded-sm border border-line px-8 py-2 font-semibold text-fg transition-colors hover:border-accent hover:text-accent" target="_blank" rel="noopener">
            Source &nearr;
          </a>
        )}
        {frontmatter.live_url && (
          <a href={frontmatter.live_url} class="inline-flex items-center gap-2 rounded-sm border border-transparent bg-accent px-8 py-2 font-semibold text-white transition-colors hover:bg-accent-hover" target="_blank" rel="noopener">
            Live Demo &nearr;
          </a>
        )}
      </div>
    </header>
    <slot />
  </article>
</BaseLayout>
