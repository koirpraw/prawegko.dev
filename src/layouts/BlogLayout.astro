---
import BaseLayout from './BaseLayout.astro';
import {
  blogPostingNode,
  breadcrumbNode,
  ogImage,
  slugFromPath,
  type JsonLdBlock,
} from '../lib/structured-data';

interface Props {
  frontmatter: {
    title: string;
    description?: string;
    tags?: string[];
    /** Publication date — required: it is the BlogPosting `datePublished`. */
    date: Date;
    /** Last revision; the BlogPosting `dateModified` falls back to `date` when absent. */
    updated?: Date;
  };
}

const { frontmatter } = Astro.props;

const title = frontmatter.title || 'Blog Post';
const description = frontmatter.description || '';
const slug = slugFromPath(Astro.url.pathname);
const card = ogImage(slug, title);

const structuredData: JsonLdBlock[] = [
  {
    id: 'ld-blogposting',
    data: blogPostingNode({
      title,
      description,
      path: Astro.url.pathname,
      datePublished: frontmatter.date,
      dateModified: frontmatter.updated,
      tags: frontmatter.tags,
      image: card.url,
    }),
  },
  {
    id: 'ld-breadcrumb',
    data: breadcrumbNode([
      { name: 'Home', path: '/' },
      { name: 'Blog', path: '/blog/' },
      { name: title, path: Astro.url.pathname },
    ]),
  },
];
---

<BaseLayout
  title={title}
  description={description}
  ogType="article"
  structuredData={structuredData}
  ogSlug={slug}
>
  <article class="prose">
    <header class="mb-8">
      <h1 class="mb-0 text-4xl font-extrabold tracking-tight">{frontmatter.title}</h1>
      <div class="mt-4 flex flex-wrap items-center gap-2">
        <time class="text-sm text-muted" datetime={frontmatter.date ? frontmatter.date.toISOString().slice(0, 10) : ''}>
          {frontmatter.date ? frontmatter.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) : ''}
        </time>
        <div class="flex flex-wrap gap-1">
          {Array.from(frontmatter.tags || []).map((tag) => (
            <span class="inline-block rounded-full bg-accent/12 px-2.5 py-0.5 text-sm font-medium text-accent">{tag}</span>
          ))}
        </div>
      </div>
    </header>
    <slot />
  </article>
</BaseLayout>
