---
import BaseLayout from './BaseLayout.astro';

interface Props {
  frontmatter: {
    title: string;
    description?: string;
    tags?: string[];
    date?: Date;
  };
}

const { frontmatter } = Astro.props;
---

<BaseLayout
  title={frontmatter.title || 'Blog Post'}
  description={frontmatter.description || ''}
  ogType="article"
>
  <article class="prose">
    <header class="mb-8">
      <h1 class="mb-0 text-4xl font-extrabold tracking-tight">{frontmatter.title}</h1>
      <div class="mt-4 flex flex-wrap items-center gap-2">
        <time class="text-sm text-muted" datetime={frontmatter.date ? frontmatter.date.toISOString().slice(0, 10) : ''}>
          {frontmatter.date ? frontmatter.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) : ''}
        </time>
        <div class="flex flex-wrap gap-1">
          {Array.from(frontmatter.tags || []).map((tag) => (
            <span class="inline-block rounded-full bg-accent/12 px-2.5 py-0.5 text-sm font-medium text-accent">{tag}</span>
          ))}
        </div>
      </div>
    </header>
    <slot />
  </article>
</BaseLayout>
